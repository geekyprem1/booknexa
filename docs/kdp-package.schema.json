{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://booknexa.example/schemas/kdp-package-v1.json",
  "title": "BookNexa KDP publishing package manifest",
  "description": "Portable package contract between any book generator adapter and the local KDP preflight/publisher.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "metadata", "assets", "source"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "enum": ["ebook", "paperback", "hardcover"] },
    "metadata": { "$ref": "#/$defs/packagePath" },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manuscript", "cover"],
      "properties": {
        "manuscript": { "$ref": "#/$defs/packagePath" },
        "cover": { "$ref": "#/$defs/packagePath" },
        "preview": { "$ref": "#/$defs/packagePath" },
        "validationReport": { "$ref": "#/$defs/packagePath" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "version"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "license": { "type": "string", "maxLength": 120 },
        "sourceUrl": { "type": "string", "format": "uri" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["passed", "warnings", "not-run"] },
        "validator": { "type": "string", "maxLength": 120 },
        "validatedAt": { "type": "string", "format": "date-time" },
        "warnings": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 100 }
      }
    }
  },
  "$defs": {
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*(?:^|[/\\\\])\\.(?:[/\\\\]|$)).+"
    }
  }
}
